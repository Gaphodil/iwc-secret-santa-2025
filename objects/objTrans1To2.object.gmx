    <event eventtype="8" enumb="73">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// 
if (frame &lt; 0) exit;
if (frame == 0) event_user(13);
else if (frame == 1) event_user(14);
else if (frame == 2) event_user(15);

if (frame &lt; 3) {
    event_user(12);
    exit;
}
// recreate surfs if destroyed
if (not surface_exists(surf1)) event_user(0);
if (not surface_exists(surf2)) event_user(1);
if (not surf1_init) {
    surface_set_target(surf1);
        draw_clear_alpha(c_white, 0);
        draw_sprite(spr1, 0, 0, 0);
    surface_reset_target();
    surf1_init = true;
}
if (not surf2_init) {
    surface_set_target(surf2);
        draw_clear_alpha(c_white, 0);
        draw_sprite(spr2, 0, 0, 0);
    surface_reset_target();
    surf2_init = true;
}
// draw the new surfaces on top of application surface
//       1t2t1b2b
// 2t1t2b1b
draw_surface_part_ext(
    surf1, 0, 0, 800, 304,
    0-draw_x, 0, 1, 1, c_white, 1
);
draw_surface_part_ext(
    surf2, 0, 0, 800, 304,
    800-draw_x, 0, 1, 1, c_white, 1
);
draw_surface_part_ext(
    surf1, 0, 304, 800, 304,
    1600-draw_x, 0, 1, 1, c_white, 1
);
draw_surface_part_ext(
    surf2, 0, 304, 800, 304,
    2400-draw_x, 0, 1, 1, c_white, 1
);

draw_surface_part_ext(
    surf2, 0, 0, 800, 304,
    draw_x-2400, 304, 1, 1, c_white, 1
);
draw_surface_part_ext(
    surf1, 0, 0, 800, 304,
    draw_x-1600, 304, 1, 1, c_white, 1
);
draw_surface_part_ext(
    surf2, 0, 304, 800, 304,
    draw_x-800, 304, 1, 1, c_white, 1
);
draw_surface_part_ext(
    surf1, 0, 304, 800, 304,
    draw_x, 304, 1, 1, c_white, 1
);
event_user(12);



</string>
          </argument>
        </arguments>
      </action>
    </event>
