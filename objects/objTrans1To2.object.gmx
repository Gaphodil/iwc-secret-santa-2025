        <arguments>
          <argument>
            <kind>1</kind>
            <string>spr1 = -1;
spr2 = -1;
sprp = -1;

event_user(0);
event_user(1);
event_user(2);

start = false;

draw_x = 0;
t = 0;
dur = 40;
dur2 = 200;
x_init = 40;
x_end = 2400;

// on frame one: draw player/bow to surface, vis=false
// on frame two: save appsurf, init roomchange, draw psurf
// on frame three: save appsurf, draw room1+psurf
frame = -1;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>global.noPause = false;
player_cutscene();
// autosave
savedata_save(true);
// resume music
audio_resume_sound(global.currentMusic);

// unhide player
with (objPlayer) visible = true;
with (objBow) visible = true;

surface_free(surf1);
surface_free(surf2);
surface_free(surfp);
sprite_delete(spr1);
sprite_delete(spr2);
sprite_delete(sprp);

with (objScreenHalver) event_user(0);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (place_meeting(x,y,objPlayer) and not start) event_user(3);
if (start) {
    t++;
    if (dur &lt; dur2) {
        if (t == dur) {
            draw_x = x_init;
            t = 0-dur;
            dur = dur2;
        }
    }
    else if (t &gt;= 0) {
        var ev = ease_value(t/dur, EASE.INOUT)
        draw_x = x_init + ev * (x_end - x_init)
        if (t == dur) instance_destroy();
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
