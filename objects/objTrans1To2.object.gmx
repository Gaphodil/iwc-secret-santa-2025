        <arguments>
          <argument>
            <kind>1</kind>
            <string>///frame1
if (not surface_exists(surfp)) event_user(2);
surface_set_target(surfp);
    with (objPlayer) event_perform(ev_draw, 0);
    with (objBow)    event_perform(ev_draw, 0);
surface_reset_target();
sprp = sprite_create_from_surface(
    surfp, 0,0,800,608,
    false, false, 0,0,
)
with (objPlayer) visible = false;
with (objBow)    visible = false;
frame++;
</string>
