        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (not fuzzed) {
    with (instance_place(x, y-16, objWater)) instance_destroy();
    y -= 32;
    y_end -= 32;
    image_yscale += 1;
    sc_end += 1;
    fuzzed = true;
}
if (image_yscale == 1 and y &lt; -32) {
    instance_destroy();
    exit;
}
t = 0;

var temp = sc_end;
sc_end = sc_start;
sc_start = temp;

if (y_start &gt; y) y_start = y;
else y_end = y - (3.5)*32;

</string>
