        <arguments>
          <argument>
            <kind>1</kind>
            <string>// stretch upward to 3.5
var ev;
if (phase == 1) {
    t++;
    ev = ease_value((t/dur), EASE.INOUT);
    y = y_start + ev * (y_end - y_start)
    image_yscale = sc_start + ev * (sc_end - sc_start);
    if (t &gt;= dur) event_user(1);
}
</string>
