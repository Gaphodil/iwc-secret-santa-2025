        <arguments>
          <argument>
            <kind>1</kind>
            <string>///freeze player
global.noPause = true;
global.noRestart = true;
player_cutscene();
// stop music
audio_pause_sound(global.currentMusic)

// hide player - does not happen until end of frame!
with (objPlayer) visible = false;
with (objBow) visible = false;

// at some point load sprite from file
event_user(11);

start = true;
frame = 0;
persistent = true;
</string>
