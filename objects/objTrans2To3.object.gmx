    <event eventtype="8" enumb="73">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// 
if (frame &lt; 0) exit;
if (frame == 0) event_user(13);
else if (frame == 1) event_user(14);
else if (frame == 2) event_user(15);

if (frame &lt; 3) {
    event_user(12);
    exit;
}
// recreate surfs if destroyed
if (not surface_exists(surf1)) event_user(0);
if (not surface_exists(surf2)) event_user(1);
if (not surface_exists(surf3)) event_user(2);
if (not surf1_init) {
    surface_set_target(surf1);
        draw_clear_alpha(c_white, 0);
        draw_sprite(spr1, 0, 0, 0);
    surface_reset_target();
    surf1_init = true;
}
if (not surf2_init) {
    surface_set_target(surf2);
        draw_clear_alpha(c_white, 0);
        draw_sprite(spr2, 0, 0, 0);
    surface_reset_target();
    surf2_init = true;
}
if (not surf3_init) {
    surface_set_target(surf3);
        draw_clear_alpha(c_white, 0);
        draw_sprite(spr3, 0, 0, 0);
    surface_reset_target();
    surf3_init = true;
}
// draw the new surfaces on top of application surface
// starts 304 yoffset
// 2r3r
// 3r1r
// 1r2r
// 3l3l
// 1l1l
// 2l2l 2r2r
//      1r1r
//      3r3r
//      2l3l
//      1l2l
//      1l3l
draw_surface_part_ext(surf1, 0, 0,   400, 608, 0,      304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf1, 0, 0,   400, 608, 0, -608+304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf3, 0, 0,   400, 608, 0, -608*2 +304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf3, 0, 0,   400, 608, 0, -608*3 +304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 0, 0,   400, 608, 0, -608*4 +304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 0, 0,   400, 608, 0, -608*5 +304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf3, 400, 0, 400, 608, 0, -608*6 +304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf1, 400, 0, 400, 608, 0, -608*7 +304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 400, 0, 400, 608, 0, -608*8 +304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf3, 400, 0, 400, 608, 0, -608*9 +304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf1, 400, 0, 400, 608, 0, -608*10+304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 400, 0, 400, 608, 0, -608*11+304+draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 400, 0, 400, 608, 0, -608*12+304+draw_y, 1, 1, c_white, 1);

draw_surface_part_ext(surf1, 400, 0, 400, 608, 400,    -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf1, 400, 0, 400, 608, 400, 608-304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf3, 400, 0, 400, 608, 400, 608*2 -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf3, 400, 0, 400, 608, 400, 608*3 -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 400, 0, 400, 608, 400, 608*4 -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 400, 0, 400, 608, 400, 608*5 -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf1, 0, 0,   400, 608, 400, 608*6 -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 0, 0,   400, 608, 400, 608*7 -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf3, 0, 0,   400, 608, 400, 608*8 -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf1, 0, 0,   400, 608, 400, 608*9 -304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf3, 0, 0,   400, 608, 400, 608*10-304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 0, 0,   400, 608, 400, 608*11-304-draw_y, 1, 1, c_white, 1);
draw_surface_part_ext(surf2, 0, 0,   400, 608, 400, 608*12-304-draw_y, 1, 1, c_white, 1);
event_user(12);



</string>
          </argument>
        </arguments>
      </action>
