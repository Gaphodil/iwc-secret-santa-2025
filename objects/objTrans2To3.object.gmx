        <arguments>
          <argument>
            <kind>1</kind>
            <string>spr1 = -1;
spr2 = -1;
spr3 = -1;
sprp = -1;

event_user(0);
event_user(1);
event_user(2);
event_user(3);

start = false;

draw_y = 0;
t = 0;
dur = 40;
dur2 = 500;
y_init = 20;
y_end = 608*11;

// on frame one: draw player/bow to surface, vis=false
// on frame two: save appsurf, init roomchange, draw psurf
// on frame three: save appsurf, draw room1+psurf
frame = -1;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="1" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>global.noPause = false;
global.noRestart = false;
player_cutscene();
// autosave
savedata_save(true);
// resume music
audio_resume_sound(global.currentMusic);

// unhide player
with (objPlayer) visible = true;
with (objBow) visible = true;

surface_free(surf1);
surface_free(surf2);
surface_free(surf3);
surface_free(surfp);
sprite_delete(spr1);
sprite_delete(spr2);
sprite_delete(spr3);
sprite_delete(sprp);
// delete temp file
file_delete("Data\temp" + string(global.savenum) + ".png");

with (objScreenQuarter) event_user(0);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="2">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>// change views back
if (frame == 0) instance_destroy(objScreenHalver);
