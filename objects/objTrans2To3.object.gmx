    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if (place_meeting(x,y,objPlayer) and not start) event_user(4);
if (start) {
    t++;
    if (dur &lt; dur2) {
        if (t == dur) {
            draw_y = y_init;
            t = 0-dur;
            dur = dur2;
        }
    }
    else if (t &gt;= 0) {
        var ev = ease_value(t/dur, EASE.INOUT)
        draw_y = y_init + ev * (y_end - y_init)
        if (t == dur) instance_destroy();
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="25">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
