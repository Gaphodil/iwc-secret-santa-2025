        <arguments>
          <argument>
            <kind>1</kind>
            <string>///draw spr2
spr2 = sprite_create_from_surface(
    application_surface, 0,0,800,608,
    false, false, 0,0,
)
frame++;

// fake the old frame again
draw_sprite(spr1, 0, 0, -304);
draw_sprite(spr1, 0, 0,  304);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="24">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///draw spr1
spr1 = sprite_create_from_surface(
    application_surface, 0,0,800,608,
    false, false, 0,0,
)
// do goto - does not happen until end of frame!
room_goto_next();
// move player
with (objPlayer) {
    // y = (y+304) mod 608;
    x = (x+400) mod 800;
}
frame++;

// fake the old frame
draw_sprite(spr1, 0, 0, -304);
draw_sprite(spr1, 0, 0,  304);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="7" enumb="23">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///frame1
if (not surface_exists(surfp)) event_user(3);
surface_set_target(surfp);
    with (objPlayer) {
        y += 304; // fake bottom half
        event_perform(ev_draw, 0);
        y -= 304;
    }
    with (objBow) {
        y += 304;
        event_perform(ev_draw, 0);
        y -= 304;
    }
surface_reset_target();
sprp = sprite_create_from_surface(
    surfp, 0,0,800,608,
    false, false, 0,0,
)
with (objPlayer) visible = false;
with (objBow)    visible = false;
frame++;
</string>
          </argument>
        </arguments>
      </action>
    </event>
